// Based on many examples
{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "source": "~/.config/fastfetch/cachy.txt",
//        "height": 15,
        "color": {
            "1": "blue"
        },
//        "position": "top",
        "padding": {
            "top": 1,          // Top padding
            "left": 2,         // Left padding
            "right": 2         // Right padding
        }
    },
    "display": {
        "separator": "",
         "constants": [
        // CONSTANT {$1} - VERTICAL BARS
        "\u001b[34m│                                     │\u001b[37D\u001b[39m",
        //constant {$2}
        "\u001b[34m│                                                   │\u001b[51D\u001b[39m"
      ]
          },
    "modules": [
        "break",
        {
            "type": "custom",
            "key": " ",
            "format": "{#34}╭{#36}  user {#34}───────────────────────────────────────────╮",
        },
        {
            "type": "title",
            "format": "{$2}{#39}{user-name}{#34}@{#39}{host-name}"
        },
        {
            "key": "{#34}╰───────────────────────────────────────────────────╯",
            "type": "custom"
        },
        {
            "type": "custom",
            "key": "{#34}╭────────────╮",
            "format": "{#34}╭─────────────────────────────────────╮",
        },
        {
            "key": "{#34}│ {#35}󰇅 machine  {#34}│",
            "type": "host",
            "format": "{$1}{name}  {#33}{version}"
        },
        {
            "key": "{#34}│ {#35}{icon} distro   {#34}│",
            "type": "os",
            "format": "{$1}{pretty-name} {codename} {#33}[{version}] [{arch}]"
        },
        {
            "key": "{#34}│ {#35}{icon} kernel   {#34}│",
            "type": "kernel",
            "format": "{$1}{sysname}  {#33}[v{release}]"
        },
        {
            "key": "{#34}│ {#35}󰇄 desktop  {#34}│",
            "type": "de",
            "format": "{$1}{pretty-name}  {#33}[v{version}]"
        },
        {
            "key": "{#34}│ {#35} terminal {#34}│",
            "type": "terminal",
            "format": "{$1}{pretty-name}  {#33}[{version}]"
        },
        {
            "key": "{#34}│ {#35} shell    {#34}│",
            "type": "shell",
            "format": "{$1}{pretty-name}  {#33}[v{version}]"
        },
        {
            "type": "command",
            "key": "{#34}│ {#35}󰃰 os age   {#34}│",
            "shell": "/bin/bash",
            "text": "b=$(stat -c %W /); [ \"$b\" -gt 0 ] || b=$(stat -c %Y /etc/machine-id); echo \"$(( ($(date +%s) - b) / 86400 )) days\"",
            "format": "{$1}{result}"
        },
        {
            "type": "uptime",
            "key": "{#34}│ {#35}󰥔 uptime   {#34}│",
            "format": "{$1}{days}d {hours}h {minutes}m"
        },
        {
            "key": "{#34}│ {#35}{icon} cpu      {#34}│",
            "type": "cpu",
            "showPeCoreCount": true,
            "temp": true,
            "format": "{$1}{name}"
        },
        {
            "type": "gpu",
            "key": "{#34}│ {#35}{icon} gpu      {#34}│",
            "detectionMethod": "auto",
            "driverSpecific": true,
            "format": "{$1}{name}"
        },
        {
            "key": "{#34}│ {#35}{icon} memory   {#34}│",
            "type": "memory",
            "format": "{$1}{used} / {total} {#32}({percentage}{#32})"
        },
        {
            "type": "custom",
            "key": "{#34}╰────────────╯",
            "format": "{#34}╰─────────────────────────────────────╯",
        },
        {
            "type": "custom",
            "key": " ",
            "format": "{#34}╭{#36} 󱥚 colors {#34}─────────────────────────────────────────╮",
        },
        {
            "type": "custom",
            "format": "{$2}{#93}󰮯  {#97}󰊠 {#36}󰊠 {#96}󰊠 {#35}󰊠 {#95}󰊠 {#34}󰊠 {#94}󰊠 {#33}󰊠 {#93}󰊠 {#32}󰊠 {#92}󰊠 {#31}󰊠 {#91}󰊠 {#30}󰊠 {#90}󰊠 "
        },
        {
            "key": "{#34}╰───────────────────────────────────────────────────╯",
            "type": "custom"
        }
    ]
}
